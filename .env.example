# Copy to .env next to compose.yaml on the server. DOMAIN, HSTS_SECONDS and ADMIN_ALLOWED_IPS,
# which caddy/Caddyfile uses, are Caddy's: they're in /srv/edge/.env.

# Both are required. Make each one with:  openssl rand -hex 32
# Use hex: the password goes into a database address, where other characters would need escaping.
# The password protects Umami's own PostgreSQL; the secret signs its login tokens.
# Moving the statistics from the blog's folder: copy both from /srv/prabuddh-me/.env, unchanged.
# The database keeps the password it was made with, so a new one would lock Umami out of it.
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=

# Visits from these addresses aren't counted, so your own don't show up: IPs or ranges
# separated by commas (not spaces). With Tailscale, your devices' ranges:
# STATS_IGNORE_IPS=100.64.0.0/10,fd7a:115c:a1e0::/48
